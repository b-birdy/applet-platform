{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "outDir": ".tsbuild",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["env.d.ts", "**/*.ts", "**/*.vue"]
}
