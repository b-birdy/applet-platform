{
  "id": "cebsb-exam",
  "name": "CEBSB汉英双拼练习",
  "icon": "icon.svg",
  "entry": "index.html",
  "version": "1.4",
  "description": "听英语语音猜汉字的汉英双拼练习：内置 430 字词库，支持整字配字与拆字配字，支持在线音源发音（联网朗读，不依赖系统语音包；可切换引擎与语速/口音），成绩与偏好按登录用户隔离保存。",
  "external_apis": ["fanyi.baidu.com", "dict.youdao.com"],
  "tables": [
    {
      "name": "cebsb_stats",
      "columns": [
        { "name": "seq", "type": "integer", "required": true },
        { "name": "char", "type": "text" },
        { "name": "pinyin", "type": "text" },
        { "name": "total", "type": "integer", "default": 0 },
        { "name": "correct", "type": "integer", "default": 0 },
        { "name": "wrong", "type": "integer", "default": 0 },
        { "name": "updated_at", "type": "text" }
      ]
    },
    {
      "name": "cebsb_answers",
      "columns": [
        { "name": "seq", "type": "integer", "required": true },
        { "name": "char", "type": "text" },
        { "name": "correct", "type": "integer", "default": 0 },
        { "name": "style", "type": "text" },
        { "name": "answered_at", "type": "text" }
      ]
    },
    {
      "name": "cebsb_settings",
      "columns": [
        { "name": "voice_uri", "type": "text" },
        { "name": "zh_voice_uri", "type": "text" },
        { "name": "rate", "type": "text" },
        { "name": "zh_repeat", "type": "text" },
        { "name": "style", "type": "text" },
        { "name": "mode", "type": "text" },
        { "name": "count", "type": "integer", "default": 100 },
        { "name": "source", "type": "text" },
        { "name": "online_voice", "type": "text" },
        { "name": "online_voice_zh", "type": "text" }
      ]
    }
  ]
}
